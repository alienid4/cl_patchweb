# systemd 服務範例（放 /etc/systemd/system/webvuln.service，改路徑後啟用）
# 由使用者在 221 上部署；Claude SSH 不到 221。
#   sudo cp webvuln.service.example /etc/systemd/system/webvuln.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now webvuln
[Unit]
Description=CL_WebVuln 弱點彙總網頁版
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/webvuln/APP
Environment=WEBVULN_DB_URL=sqlite:////opt/webvuln/data/vuln.db
ExecStart=/opt/webvuln/APP/.venv/bin/python -m uvicorn webvuln.main:app --host 0.0.0.0 --port 3100
Restart=on-failure
User=webvuln

[Install]
WantedBy=multi-user.target
